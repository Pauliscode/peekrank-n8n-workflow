                      "id":  "a1f0c001-0007-4000-8000-000000000007",
                      "name":  "Aggregate",
                      "type":  "n8n-nodes-base.aggregate",
                      "typeVersion":  1,
                      "position":  [
                                       1320,
                                       -100
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const cambios = $input.first().json.cambios;\nconst datos = $(\u0027Get changelog\u0027).first().json.data;\n\n// Fecha en hora de Madrid, por ejemplo 16/11/2026\nconst dia = (ms) =\u003e new Intl.DateTimeFormat(\u0027es-ES\u0027, { timeZone: \u0027Europe/Madrid\u0027, day: \u00272-digit\u0027, month: \u00272-digit\u0027, year: \u0027numeric\u0027 }).format(new Date(ms));\n\n// until no entra en la semana: el último día es el de justo antes\nconst desde = dia(Date.parse(datos.since));\nconst hasta = dia(Date.parse(datos.until) - 1);\n\n// Agrupar los cambios por versión, en el orden en que llegan\nconst versiones = new Map();\nfor (const c of cambios) {\n  if (!versiones.has(c.version)) versiones.set(c.version, { fecha: dia(Date.parse(c.published_at)), lista: [] });\n  versiones.get(c.version).lista.push(c.changes);\n}\n\nconst bloques = [];\nfor (const [version, v] of versiones) {\n  const lineas = v.lista.map((x) =\u003e `- [${x.type_label}] ${x.title}\\n  ${x.text}`);\n  bloques.push(`Versión ${version} (${v.fecha})\\n\\n${lineas.join(\u0027\\n\\n\u0027)}`);\n}\n\nreturn [{ json: {\n  asunto: `Novedades de PeekRank: del ${desde} al ${hasta}`,\n  texto: bloques.join(\u0027\\n\\n----------\\n\\n\u0027),\n} }];"
                                     },
                      "id":  "a1f0c001-0008-4000-8000-000000000008",
