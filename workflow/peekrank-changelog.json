{
  "name": "PeekRank weekly changelog email",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                3
              ],
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1f0c001-0001-4000-8000-000000000001",
      "name": "Every Wednesday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-PEEKRANK-HOST/CHANGELOG-ENDPOINT",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.setZone('Europe/Madrid').startOf('week').minus({ weeks: 1 }).toISODate() }}"
            },
            {
              "name": "until",
              "value": "={{ $now.setZone('Europe/Madrid').startOf('week').toISODate() }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1f0c001-0002-4000-8000-000000000002",
      "name": "Get changelog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.data.total.public }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c001-0003-4000-8000-000000000003",
      "name": "Any public changes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data.releases",
        "include": "noOtherFields",
        "options": {}
      },
      "id": "a1f0c001-0004-4000-8000-000000000004",
      "name": "Split releases",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        -100
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "changes",
        "include": "allOtherFields",
        "options": {}
      },
      "id": "a1f0c001-0005-4000-8000-000000000005",
      "name": "Split changes",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        880,
        -100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.changes.public }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c001-0006-4000-8000-000000000006",
      "name": "Only public",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        1100,
        -100
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "cambios",
        "options": {}
      },
      "id": "a1f0c001-0007-4000-8000-000000000007",
      "name": "Aggregate",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1320,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const cambios = $input.first().json.cambios;\nconst datos = $('Get changelog').first().json.data;\nconst formato = new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', day: '2-digit', month: '2-digit', year: 'numeric' });\nconst dia = (ms) => formato.format(new Date(ms));\nconst desde = dia(Date.parse(datos.since));\nconst hasta = dia(Date.parse(datos.until) - 1);\nconst versiones = [...new Set(cambios.map((c) => c.version))];\nconst linea = (c) => '- [' + c.changes.type_label + '] ' + c.changes.title + '\\n  ' + c.changes.text;\nconst deVersion = (v) => cambios.filter((c) => c.version === v);\nconst cabecera = (v) => 'Versión ' + v + ' (' + dia(Date.parse(deVersion(v)[0].published_at)) + ')';\nconst bloque = (v) => cabecera(v) + '\\n\\n' + deVersion(v).map(linea).join('\\n\\n');\nconst texto = versiones.map(bloque).join('\\n\\n----------\\n\\n');\nconst asunto = 'Novedades de PeekRank: del ' + desde + ' al ' + hasta;\nreturn [{ json: { asunto, texto } }];"
      },
      "id": "a1f0c001-0008-4000-8000-000000000008",
      "name": "Write email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -100
      ]
    },
    {
      "parameters": {
        "fromEmail": "",
        "toEmail": "",
        "subject": "={{ $json.asunto }}",
        "emailFormat": "text",
        "text": "={{ $json.texto }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a1f0c001-0009-4000-8000-000000000009",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1760,
        -100
      ]
    }
  ],
  "connections": {
    "Every Wednesday 08:00": {
      "main": [
        [
          {
            "node": "Get changelog",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get changelog": {
      "main": [
        [
          {
            "node": "Any public changes?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any public changes?": {
      "main": [
        [
          {
            "node": "Split releases",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Split releases": {
      "main": [
        [
          {
            "node": "Split changes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split changes": {
      "main": [
        [
          {
            "node": "Only public",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only public": {
      "main": [
        [
          {
            "node": "Aggregate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate": {
      "main": [
        [
          {
            "node": "Write email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write email": {
      "main": [
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Madrid"
  },
  "active": false
}
